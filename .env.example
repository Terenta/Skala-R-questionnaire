ANALYTICS_USER=analytics
ANALYTICS_PASSWORD=replace-with-a-long-random-password
SURVEY_PASSWORD=replace-with-a-long-random-password
SURVEY_COOKIE_PATH=/
SURVEY_PORT=3000

# Раскомментируйте обе строки, если reverse proxy работает в Docker.
# Тогда обычный `docker compose up -d` всегда подключает приложение к общей сети.
# COMPOSE_FILE=docker-compose.yml:docker-compose.shared-network.yml
# REVERSE_PROXY_NETWORK=proxy
